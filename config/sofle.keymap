#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&mt {
    flavor = "tap-preferred";
    require-prior-idle-ms = <100>;
    quick-tap-ms = <200>;
    tapping-term-ms = <150>;
};

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        jk_to_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <31 32>;
            require-prior-idle-ms = <0>;
            layers = <0>;
            timeout-ms = <25>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE      &kp N1              &kp N2          &kp N3              &kp N4            &kp N5                          &kp N6  &kp N7             &kp N8               &kp N9          &kp N0                  &kp MINUS
&kp TAB        &kp Q               &kp W           &kp E               &kp R             &kp T                           &kp Y   &kp U              &kp I                &kp O           &kp P                   &kp EQUAL
&kp BACKSPACE  &mt LEFT_COMMAND A  &mt LEFT_ALT S  &mt LEFT_CONTROL D  &mt LEFT_SHIFT F  &kp G                           &kp H   &mt RIGHT_SHIFT J  &mt RIGHT_CONTROL K  &mt LEFT_ALT L  &mt RIGHT_COMMAND SEMI  &kp SQT
&kp LSHFT      &kp Z               &kp X           &kp C               &kp V             &kp B   &tog 5       &none      &kp N   &kp M              &kp COMMA            &kp DOT         &kp FSLH                &kp BACKSLASH
                                   &kp LCTRL       &kp LALT            &kp LEFT_COMMAND  &mo 1   &kp ENTER    &kp SPACE  &mo 2   &kp RIGHT_ALT      &kp ESCAPE           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym {
            display-name = "syn";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F1      &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                    &kp F7  &kp F8          &kp F9          &kp F10          &kp F11    &kp F12
&trans      &trans  &trans  &trans  &trans  &trans                    &trans  &mkp LCLK       &mmv MOVE_LEFT  &mkp RCLK        &trans     &trans
&trans      &trans  &trans  &trans  &trans  &trans                    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp EQUAL  &trans
&kp ESCAPE  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans          &trans           &kp BSLH   &trans
                    &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp F12 F11>, <&inc_dec_kp PG_UP PG_DN>;
        };

        util {
            display-name = "util";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans          &trans                &trans                 &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp LEFT_BRACE  &kp LBKT              &kp RBKT               &kp RIGHT_BRACE  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans                &trans                 &trans           &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans                &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                   &none  &none           &none            &none            &none  &none
&ext_power EP_ON   &none            &none            &none            &none            &none                          &none  &none           &none            &none            &none  &none
&ext_power EP_OFF  &rgb_ug RGB_SPI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &none                          &none  &rgb_ug RGB_ON  &rgb_ug RGB_OFF  &rgb_ug RGB_EFF  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_SPD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &none         &trans    &none  &none  &none           &none            &none            &none  &none
                                    &none            &none            &none            &none         &none     &none  &none  &none           &none            &none
            >;
        };

        mods {
            bindings = <
&trans  &trans          &trans            &trans        &trans            &trans                    &trans  &trans             &trans         &trans             &trans           &trans
&trans  &trans          &trans            &trans        &trans            &trans                    &trans  &trans             &trans         &trans             &trans           &trans
&trans  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND  &trans                    &trans  &kp RIGHT_COMMAND  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &trans
&trans  &trans          &trans            &trans        &trans            &trans  &trans    &trans  &trans  &trans             &trans         &trans             &trans           &trans
                        &trans            &trans        &trans            &trans  &trans    &trans  &trans  &trans             &trans         &trans
            >;
        };

        gaming {
            bindings = <
&kp ESCAPE     &kp N1  &kp N2     &kp N3    &kp N4    &kp N5                           &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB        &kp Q   &kp W      &kp E     &kp R     &kp T                            &kp Y   &kp U   &kp I      &kp O    &kp P     &kp EQUAL
&kp BACKSPACE  &kp A   &kp S      &kp D     &kp F     &kp G                            &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z   &kp X      &kp C     &kp V     &kp B      &trans     &trans     &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                       &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE  &kp RET    &kp SPACE  &trans  &trans  &trans     &trans
            >;
        };
    };
};
